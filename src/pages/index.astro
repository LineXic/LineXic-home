---
import Parser from "rss-parser";
import { RSS_URL, formatDate, excerptFrom } from "../utils/rss";
import "../styles/home.css";

const parser = new Parser();

let feedTitle = "最新文章";
let feedLink = "https://www.linexic.top/";
let articles: any[] = [];

try {
	const response = await fetch(RSS_URL);
	if (response.ok) {
		const xml = await response.text();
		const feed = await parser.parseString(xml);
		feedTitle = feed.title ?? feedTitle;
		feedLink = feed.link ?? feedLink;
		articles = (feed.items ?? []).slice(0, 6);
	}
} catch (error) {
	articles = [];
}
---

<html lang="zh-CN">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="viewport" content="width=device-width" />
		<meta name="generator" content={Astro.generator} />
		<meta name="color-scheme" content="light dark" />
		<title>LineXic</title>
	</head>
	<body>
		<main>
			<section class="hero">
				<img class="avatar" src="/avatar.png" alt="头像" loading="lazy" />
				<div>
					<p class="eyebrow">个人主页</p>
					<h1>LineXic</h1>
					<p class="subtitle">记录日常、折腾与灵感。这里是我的数字书房与创作归档。</p>
					<div class="actions">
						<a class="button primary" href={feedLink} target="_blank" rel="noreferrer">进入博客</a>
						<a class="button" href={RSS_URL} target="_blank" rel="noreferrer">订阅 RSS</a>
					</div>
					<div class="meta-grid">
						<div class="meta-card">
							<span class="meta-icon" aria-hidden="true">
								<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
									<circle cx="12" cy="12" r="10" />
									<circle cx="12" cy="10" r="3" />
									<path d="M7 20.662V19a2 2 0 0 1 2-2h6a2 2 0 0 1 2 2v1.662" />
								</svg>
							</span>
							<div class="meta-text">
								<p class="meta-title">身份</p>
								<p class="meta-value">学生</p>
							</div>
						</div>
						<div class="meta-card">
							<span class="meta-icon" aria-hidden="true">
								<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
									<path d="M17.97 9.304A8 8 0 0 0 2 10c0 4.69 4.887 9.562 7.022 11.468" />
									<path d="M21.378 16.626a1 1 0 0 0-3.004-3.004l-4.01 4.012a2 2 0 0 0-.506.854l-.837 2.87a.5.5 0 0 0 .62.62l2.87-.837a2 2 0 0 0 .854-.506z" />
									<circle cx="10" cy="10" r="3" />
								</svg>
							</span>
							<div class="meta-text">
								<p class="meta-title">地址</p>
								<p class="meta-value">中国</p>
							</div>
						</div>
						<div class="meta-card">
							<span class="meta-icon" aria-hidden="true">
								<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
									<circle cx="12" cy="12" r="10" />
									<path d="M12 2a14.5 14.5 0 0 0 0 20 14.5 14.5 0 0 0 0-20" />
									<path d="M2 12h20" />
								</svg>
							</span>
							<div class="meta-text">
								<p class="meta-title">语言</p>
								<p class="meta-value">中文</p>
							</div>
						</div>
					</div>
				</div>
			</section>

			<section class="section" id="rss-section">
				<div class="section-head">
					<h2 id="rss-title">{feedTitle}</h2>
					<div class="section-actions">
						<button id="refresh-btn" class="refresh-btn" aria-label="刷新 RSS">
							<svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
								<polyline points="23 4 23 10 17 10" />
								<path d="M20.49 15a9 9 0 1 1-2.12-9.36L23 10" />
							</svg>
						</button>
						<a href={feedLink} target="_blank" rel="noreferrer" id="rss-link">查看全部</a>
					</div>
				</div>
				<div id="rss-articles" class="articles" data-state={articles.length ? "loaded" : "empty"}>
					{articles.length ? (
						articles.map((article: any) => (
							<article class="article-card">
								<h3>
									<a href={article.link} target="_blank" rel="noreferrer">
										{article.title}
									</a>
								</h3>
								<p class="article-meta">
									{formatDate(article.isoDate || article.pubDate)}
								</p>
								{excerptFrom(article) ? (
									<p class="article-desc">{excerptFrom(article)}</p>
								) : null}
							</article>
						))
					) : (
						<div class="empty">
							RSS 内容加载中或暂时不可用，稍后刷新即可展示最新文章。
						</div>
					)}
				</div>
				<p id="rss-status" class="rss-status"></p>
			</section>

			<footer>© {new Date().getFullYear()} LineXic · Built with Astro.</footer>
		</main>
	</body>
</html>

<script>
	const RSS_URL = "https://www.linexic.top/rss.xml";

	function formatDate(value) {
		if (!value) return "";
		const date = new Date(value);
		if (Number.isNaN(date.getTime())) return "";
		return date.toLocaleDateString("zh-CN", {
			year: "numeric", month: "short", day: "2-digit",
		});
	}

	function textFrom(value) {
		return (value || "").replace(/<[^>]*>/g, " ").replace(/\s+/g, " ").trim();
	}

	function excerptFrom(item) {
		const raw = item.contentSnippet || item.summary || item.content || item["content:encoded"] || "";
		const cleaned = textFrom(String(raw));
		return cleaned.length > 120 ? cleaned.slice(0, 120) + "…" : cleaned;
	}

	function escapeHtml(str) {
		const div = document.createElement("div");
		div.appendChild(document.createTextNode(str));
		return div.innerHTML;
	}

	async function fetchAndRenderRSS() {
		const container = document.getElementById("rss-articles");
		const titleEl = document.getElementById("rss-title");
		const linkEl = document.getElementById("rss-link");
		const statusEl = document.getElementById("rss-status");
		const refreshBtn = document.getElementById("refresh-btn");

		if (!container) return;

		refreshBtn?.classList.add("spinning");
		statusEl.textContent = "正在获取最新内容…";

		try {
			const response = await fetch(RSS_URL);
			if (!response.ok) throw new Error("HTTP " + response.status);
			const xml = await response.text();
			const doc = new DOMParser().parseFromString(xml, "text/xml");

			const feedTitle = doc.querySelector("channel > title")?.textContent || "最新文章";
			const feedLink = doc.querySelector("channel > link")?.textContent || RSS_URL;

			if (titleEl) titleEl.textContent = feedTitle;
			if (linkEl) linkEl.href = feedLink;

			const items = Array.from(doc.querySelectorAll("item")).slice(0, 6);

			if (items.length === 0) {
				container.innerHTML = '<div class="empty">暂无文章</div>';
				container.dataset.state = "empty";
				statusEl.textContent = "";
				return;
			}

			container.innerHTML = items.map((item) => {
				const title = escapeHtml(item.querySelector("title")?.textContent || "");
				const link = escapeHtml(item.querySelector("link")?.textContent || "#");
				const pubDate = item.querySelector("pubDate")?.textContent || "";
				const isoDate = item.querySelector("isoDate")?.textContent || pubDate;
				const desc = item.querySelector("description")?.textContent || "";

				const excerpt = excerptFrom({ contentSnippet: desc, summary: desc });

				const dateStr = formatDate(isoDate);
				const descHtml = excerpt ? `<p class="article-desc">${escapeHtml(excerpt)}</p>` : "";

				return `<article class="article-card">
					<h3><a href="${link}" target="_blank" rel="noreferrer">${title}</a></h3>
					<p class="article-meta">${dateStr}</p>
					${descHtml}
				</article>`;
			}).join("");

			container.dataset.state = "loaded";
			statusEl.textContent = "最后更新: " + new Date().toLocaleTimeString("zh-CN");
		} catch (err) {
			console.error("RSS fetch failed:", err);
			if (container.dataset.state === "empty") {
				container.innerHTML = '<div class="empty">RSS 内容暂时不可用，稍后刷新即可展示最新文章。</div>';
			}
			statusEl.textContent = "获取失败，请稍后再试";
		} finally {
			refreshBtn?.classList.remove("spinning");
		}
	}

	document.addEventListener("DOMContentLoaded", () => {
		fetchAndRenderRSS();
		document.getElementById("refresh-btn")?.addEventListener("click", fetchAndRenderRSS);
		setInterval(fetchAndRenderRSS, 300000);
	});
</script>

<style>
	.section-actions {
		display: flex;
		align-items: center;
		gap: 10px;
	}

	.refresh-btn {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		width: 36px;
		height: 36px;
		border-radius: 50%;
		border: 1px solid var(--accent);
		background: transparent;
		color: var(--accent);
		cursor: pointer;
		transition: transform 0.2s ease, box-shadow 0.2s ease, background 0.2s ease;
		padding: 0;
	}

	.refresh-btn:hover {
		background: rgba(79, 143, 224, 0.1);
		box-shadow: 0 4px 12px rgba(79, 143, 224, 0.18);
	}

	.refresh-btn.spinning svg {
		animation: spin 0.6s linear infinite;
	}

	@keyframes spin {
		to { transform: rotate(360deg); }
	}

	.rss-status {
		font-size: 12px;
		color: var(--ink-soft);
		margin: 0;
		text-align: right;
		min-height: 1.2em;
	}
</style>